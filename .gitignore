*.json
!looker_studio_export/*.json
!package.json
!package-lock.json
service-account*.json
credentials.json
client_secret*.json
token.json
*.pem
*.key
*.p12

# ====================
# Logs
# ====================
*.log
logs/
log/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ====================
# Local Config
# ====================
# Don't commit local configuration overrides
dashboard_ui/config.local.js
config.local.py
local_settings.py

# ====================
# Test & Coverage
# ====================
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ====================
# Build Outputs
# ====================
build/
dist/
out/
*.build/

# ====================
# Archive Files
# ====================
archive_report_*.txt

# ====================
# Temporary Files
# ====================
*.tmp
*.temp
*.bak
*.backup
~$*

# ====================
