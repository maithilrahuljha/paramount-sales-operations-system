npm-debug.log
yarn-error.log

# ====================
# Documentation Build
# ====================
docs/_build/
site/

# ============================================================================
# NOTES
# ============================================================================
# 1. Add any sensitive files to this list before committing
# 2. Use `git status` to verify files are being ignored
# 3. If you've already committed a file, use:
#    git rm --cached <filename>
# 4. For JSON files that SHOULD be tracked, use negation (!)
# ============================================================================
