*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
.ENV/

# ====================
# Environment Variables
# ====================
.env
.env.local
.env.*.local
*.env
env.json
secrets.json

# ====================
